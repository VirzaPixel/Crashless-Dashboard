# Supabase Configuration
# Get these from https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Push delivery worker secrets are configured in Supabase Edge Function Secrets,
# never exposed to Vite/browser builds:
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_JSON={...service-account-json...}
# NOTIFICATION_WORKER_SECRET=long-random-secret-for-scheduled-worker

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values with your actual Supabase credentials
# 3. Never commit .env to version control!
# 4. For Vite to read env variables, they MUST start with VITE_
