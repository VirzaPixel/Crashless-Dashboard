# Crashless-Web: jangan pernah commit rahasia, kredensial, atau artefak lokal.
# File contoh (.env.example) boleh dilacak; file env berisi nilai nyata tidak boleh.

# Env dalam bentuk apa pun, di folder mana pun
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example

# Kredensial, kunci, sertifikat, dan token
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.asc
*.gpg
*.age
*id_rsa*
*id_ed25519*
secrets.json
secrets.yaml
secrets.yml
credentials.json
service-account*.json
*-service-account.json
.supabase/
service_role*.txt

# Konfigurasi otorisasi lokal
.npmrc
.yarnrc
.pnp.*

